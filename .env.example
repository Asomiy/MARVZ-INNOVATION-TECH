# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform browser/server API key for office map & geocoding.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Official MARVZ & INNOVATION TECH Contact Form Email Notification (Server-Side SMTP Only)
# For Gmail SMTP, use SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_SECURE="true", and a Google App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="marvzinnovationtech@gmail.com"
SMTP_PASS="YOUR_SMTP_APP_PASSWORD"
SMTP_FROM_NAME="MARVZ & INNOVATION TECH"
SMTP_FROM_EMAIL="marvzinnovationtech@gmail.com"
CONTACT_RECIPIENT_EMAIL="marvzinnovationtech@gmail.com"

# MARVZ Admin Panel Authentication (Optional overrides; first-time setup UI handles initial password creation)
# ADMIN_EMAIL="admin@marvztech.com"
# ADMIN_INITIAL_PASSWORD=""
# COOKIE_SECURE="true" # Set to "true" behind HTTPS reverse proxies if TLS terminates upstream

